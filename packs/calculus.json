 "notes": {
  "1.1": {
   "points": [
    "定义域：分母≠0，偶次根号内≥0，对数真数>0",
    "复合函数 f(g(x))：内层的取值要落在外层定义域内",
    "五类基本初等函数：幂、指数、对数、三角、反三角"
   ],
   "types": [
    "求定义域",
    "判断奇偶性"
   ],
   "examples": [
    {
     "q": "求 y = ln(x−2) + √(3−x) 的定义域",
     "a": "x−2>0 且 3−x≥0，得 2<x≤3，定义域 (2, 3]"
    }
   ],
   "exercises": [
    "求 y = 1/(x²−4) 的定义域",
    "判断 f(x) = x·cos x 的奇偶性",
    "设 f(x)=x²，g(x)=x+1，求 f(g(x))"
   ]
  },
  "1.2": {
   "points": [
    "ε-N 定义：任给 ε>0，存在 N，当 n>N 时 |aₙ−a|<ε",
    "收敛数列必有界；有界不一定收敛",
    "夹逼准则：两边趋于同一极限，中间也趋于它"
   ],
   "types": [
    "用定义证明极限",
    "用夹逼准则求极限"
   ],
   "examples": [
    {
     "q": "求 lim(n→∞) sin n / n",
     "a": "|sin n / n| ≤ 1/n → 0，由夹逼准则得极限 0"
    }
   ],
   "exercises": [
    "lim(n→∞) (n+1)/n",
    "lim(n→∞) (1+1/n)^n",
    "lim(n→∞) 2^n/n!"
   ]
  },
  "1.3": {
   "points": [
    "左极限与右极限都存在且相等，极限才存在",
    "x→x₀ 与 x→∞ 是两类不同过程",
    "极限是否存在，与函数在该点有没有定义无关"
   ],
   "types": [
    "分段函数在分界点的极限",
    "0/0 型用等价无穷小"
   ],
   "examples": [
    {
     "q": "求 lim(x→0) (1−cos x)/x²",
     "a": "1−cos x ~ x²/2，原式 = 1/2",
     "verify": {
      "kind": "limit",
      "args": [
       "(1-cos(x))/x**2",
       "x",
       "0",
       "1/2"
      ]
     }
    },
    {
     "q": "求 lim(x→0) sin3x/x",
     "a": "sin3x ~ 3x，原式 = 3",
     "verify": {
      "kind": "limit",
      "args": [
       "sin(3*x)/x",
       "x",
       "0",
       "3"
      ]
     }
    }
   ],
   "exercises": [
    "lim(x→0) sin5x/x",
    "lim(x→∞) (2x²+1)/(x²−3)",
    "lim(x→0) (e^x−1)/x"
   ]
  },
  "1.4": {
   "points": [
    "无穷小是极限为 0 的变量，不是“很小的数”",
    "等价无穷小：sin u~u，1−cos u~u²/2，e^u−1~u，ln(1+u)~u",
    "等价替换只在乘除中直接使用，加减中要先合并"
   ],
   "types": [
    "比较无穷小的阶",
    "用等价替换求极限"
   ],
   "examples": [
    {
     "q": "当 x→0 时，比较 1−cos x 与 x² 的阶",
     "a": "1−cos x ~ x²/2，与 x² 同阶（等价于 x²/2）",
     "verify": {
      "kind": "limit",
      "args": [
       "(1-cos(x))/x**2",
       "x",
       "0",
       "1/2"
      ]
     }
    }
   ],
   "exercises": [
    "lim(x→0) tan x/x",
    "lim(x→0) ln(1+x)/x",
    "lim(x→0) (e^(2x)−1)/x"
   ]
  },
  "1.5": {
   "points": [
    "连续三条件：有定义、极限存在、极限等于函数值",
    "间断点分两类：可去与跳跃、无穷与振荡",
    "闭区间连续函数：有界、取得最值、有介值"
   ],
   "types": [
    "判断间断点类型",
    "求使函数连续的待定参数"
   ],
   "examples": [
    {
     "q": "f(x) = (x²−1)/(x−1)（x≠1），f(1)=a。f 在 x=1 连续时 a 等于多少",
     "a": "x→1 时 (x²−1)/(x−1) = x+1 → 2，所以 a = 2",
     "verify": {
      "kind": "limit",
      "args": [
       "(x**2-1)/(x-1)",
       "x",
       "1",
       "2"
      ]
     }
    }
   ],
   "exercises": [
    "判断 f(x)=1/x 在 x=0 的间断点类型",
